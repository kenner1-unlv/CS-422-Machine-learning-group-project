{
  "coverage_set": "primary_100",
  "shared_variants": ["weather_only", "weather_plus_trend"],
  "exploratory_variants": ["trend_residual"],
  "random_state": 42,
  "loss": "squared_error",
  "default_model": {"n_estimators": 100, "learning_rate": 0.1, "max_depth": 3, "subsample": 1.0, "min_samples_leaf": 1},
  "grid": {
    "learning_rate": [0.05, 0.1],
    "max_depth": [2, 3, 4],
    "subsample": [0.8, 1.0],
    "min_samples_leaf": [1, 20]
  },
  "max_n_estimators": 600,
  "selection_metric": "validation_MAE",
  "tie_break": "validation MAE, validation RMSE, smaller max_depth, fewer trees",
  "permutation_repeats": 5,
  "refit_on_validation": false
}
